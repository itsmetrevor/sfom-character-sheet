{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Character",
  "type": "object",
  "required": ["id", "name", "ancestry", "backgrounds", "main-class"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "ancestry": { "type": "string" },
    "backgrounds": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string" } },
    "main-class": { "type": "string" },
    "sub-class": { "type": ["string", "null"] },
    "party-level": { "type": "integer", "minimum": 0 },
    "x": { "type": "integer", "minimum": 1 },
    "expertise": { "type": "object", "additionalProperties": { "type": "integer" } },
    "equipment": {
      "type": "object",
      "properties": {
        "main-hand": { "type": ["string", "null"] },
        "off-hand": { "type": ["string", "null"] },
        "armor": { "type": ["string", "null"] },
        "accessories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inventory": { "type": "array", "items": { "type": "object", "required": ["gear", "qty"], "properties": { "gear": { "type": "string" }, "qty": { "type": "integer", "minimum": 1 } } } },
    "shards": { "type": "integer", "minimum": 0 },
    "gold": { "type": "integer", "minimum": 0 }
  }
}
