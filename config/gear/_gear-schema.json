{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gear",
  "type": "object",
  "required": [
    "id",
    "name",
    "slot",
    "effect",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slot": {
      "type": "string",
      "enum": [
        "main-hand",
        "armor",
        "off-hand",
        "accessory",
        "item",
        "currency",
        "consumable",
        "tool"
      ]
    },
    "damage-type": {
      "type": [
        "string",
        "null"
      ],
      "description": "e.g. slashing, piercing, bludgeoning; null when N/A"
    },
    "bonus": {
      "type": [
        "object",
        "null"
      ],
      "description": "{stat, value}; null when the item grants no flat bonus",
      "required": [
        "stat",
        "value"
      ],
      "properties": {
        "stat": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "effect": {
      "type": "string",
      "description": "Effect text from the handbook notes"
    },
    "source": {
      "type": "string",
      "description": "Background id granting this as a starting item"
    },
    "stack-max": {
      "type": "integer",
      "default": 5
    }
  }
}
