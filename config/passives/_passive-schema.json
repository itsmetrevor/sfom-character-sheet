{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Passive Ability",
  "description": "Strict schema for config/passives/*.yaml. Filename (without extension) must equal id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "source", "slot", "target", "use", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case id; must match filename without .yaml extension"
    },
    "name": { "type": "string", "minLength": 1 },
    "source": { "enum": ["ancestry", "background", "class"] },
    "slot": { "enum": ["non-combat", "combat"] },
    "target": { "type": "string", "minLength": 1 },
    "use": { "type": "string", "minLength": 1 },
    "check": { "type": "string" },
    "duration": { "type": "string" },
    "condition": { "type": "string" },
    "expose": { "type": "string" },
    "description": { "type": "string", "minLength": 1 }
  }
}
