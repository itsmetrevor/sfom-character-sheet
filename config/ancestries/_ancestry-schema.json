{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ancestry",
  "description": "Strict schema for config/ancestries/*.yaml. Filename (without extension) must equal id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "languages",
    "vision",
    "max-hp",
    "expertise",
    "main-mods",
    "bonus-stat",
    "passives",
    "lore",
    "source-pages"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case id; must match filename without .yaml extension"
    },
    "name": { "type": "string", "minLength": 1 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "Ref to config/languages/<id>.yaml"
      }
    },
    "extra-language-choices": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of additional free language picks (e.g. Lagos: 1)"
    },
    "vision": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Ref to config/vision-types/<id>.yaml"
    },
    "max-hp": { "type": "integer", "minimum": 1 },
    "expertise": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 1 },
      "description": "Map of expertise-id -> ranks"
    },
    "main-mods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": { "type": "string", "minLength": 1 },
        "negative": { "type": "string", "minLength": 1 }
      }
    },
    "bonus-stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stat", "value"],
      "properties": {
        "stat": { "type": "string", "minLength": 1 },
        "value": { "type": "integer" }
      }
    },
    "passives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non-combat", "combat"],
      "properties": {
        "non-combat": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Ref to config/passives/<id>.yaml"
        },
        "combat": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Ref to config/passives/<id>.yaml"
        }
      }
    },
    "lore": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "history",
        "religion",
        "appearance",
        "culture",
        "architecture-technology",
        "naming-conventions"
      ],
      "properties": {
        "history": { "type": ["string", "null"] },
        "religion": { "type": ["string", "null"] },
        "appearance": { "type": ["string", "null"] },
        "culture": { "type": ["string", "null"] },
        "architecture-technology": { "type": ["string", "null"] },
        "naming-conventions": { "type": ["string", "null"] }
      }
    },
    "source-pages": { "type": "string", "minLength": 1 }
  }
}
